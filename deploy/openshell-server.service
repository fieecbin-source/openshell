[Unit]
Description=OpenShell Sync and Relay Server
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openshell
Group=openshell
WorkingDirectory=/opt/openshell
EnvironmentFile=-/opt/openshell/deploy/.env
ExecStart=/opt/openshell/bin/openshell-server
Restart=always
RestartSec=5s

# Security Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

