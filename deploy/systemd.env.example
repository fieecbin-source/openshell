# Keep the real file on the server, never in Git.
# Put passwords containing spaces/#/$ inside single quotes.
SYNC_USERNAME=your_account
SYNC_PASSWORD='replace_with_your_strong_password'
HOST=127.0.0.1
PORT=8085
DATA_DIR=/opt/openshell/data
ARTIFACTS_DIR=/opt/openshell/data/artifacts
JWT_SECRET=
ALLOW_MULTI_USER=false
RELAY_ENABLED=false
RUST_LOG=openshell_server=info,tower_http=info
