# 可选 TLS 站点（仅在 ENABLE_TLS=true、docker compose --profile tls 时启用）。
# SITE_ADDRESS 支持两种写法：
#   1) 纯域名（如 sync.example.com）：Caddy 自动申请 Let's Encrypt 证书，占用 80/443；
#   2) 显式协议+端口（如 http://sync.example.com:8085）：只做 HTTP 反代，不申请证书。
{$SITE_ADDRESS:localhost} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Proxy all traffic to the OpenShell Axum backend
    reverse_proxy openshell-server:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
