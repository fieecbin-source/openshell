{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenShell",
  "version": "1.0.1",
  "identifier": "dev.openshell.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @openshell/frontend build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenShell",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Lightweight cross-platform SSH terminal workspace",
    "longDescription": "OpenShell is a lightweight, cross-platform SSH/SFTP terminal workspace with an encrypted local vault and optional self-hosted sync."
  }
}
