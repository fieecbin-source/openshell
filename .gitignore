# Analysis artifacts must never be committed (clean-room constraint)
analysis/
*.har
*.pcap
*.cap
*.pcapng

# Rust
target/
**/target/
Cargo.lock.backup

# Node & Frontend
node_modules/
**/node_modules/
.pnpm-store/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
*.local
.eslintcache
*.tsbuildinfo

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
backend/desktop/gen/
**/gen/

# Deploy / Server / Backups
deploy/backups/
**/backups/
.env
.env.*
!.env.example
*.pem
*.key
!**/certs/*.example

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.py[cod]
*$py.class

# Temporary & intermediate image generation
app-icon.png

# Logs / temp / caches / databases
*.log
tmp/
.cache/
# 构建副产物：llvm-dlltool 有时会在仓库根目录留下 0 字节 .dll 桩文件
/*.dll
# 发布脚本产出的资产目录与断点续传临时文件（不应入库）
/artifacts/
*.part
*.db
*.db-shm
*.db-wal

# Local-only design/spec documents (not published)
# 注意用 `docs/*` 而不是 `docs/`：后者会让下面的例外规则失效（目录被整体排除后无法再包含文件）
docs/*
# 例外：被 README / 发布流程引用的文档必须入库，否则会出现死链与文档丢失
!docs/UPDATE.md
!docs/RELEASING.md
!docs/E2E_UPGRADE.md
!docs/SYNC.md
# docs/ACCEPTANCE.md 含本机路径与演练记录，继续本地保留

# Build artifacts & IDE assistant caches
bin/
.agents/
.codebuddy/
.trae/
skills-lock.json
